# Copie este arquivo para .env e configure um único ambiente por execução.
# Todos os valores abaixo são fictícios e não devem ser usados em produção.
PORT=3000

# Desenvolvimento local
NODE_ENV=development
DATABASE_URL=postgresql://usuario_fake:senha_fake@localhost:5432/pagamentus_dev

# Testes automatizados: habilite estas duas linhas ao executar os testes.
# NODE_ENV=test
# DATABASE_URL_TEST=postgresql://usuario_fake:senha_fake@localhost:5432/pagamentus_test

# Produção: configure somente no ambiente de implantação/gerenciador de segredos.
# NODE_ENV=production
# DATABASE_URL=postgresql://usuario_prod_ficticio:senha_ficticia@host_ficticio:5432/pagamentus_prod

# Segurança e autenticação (valores fictícios para desenvolvimento local)
JWT_SECRET=segredo_ficticio_para_desenvolvimento_apenas_12345
SESSION_SECRET=sessao_ficticia_exemplo
TOKEN_EXPIRATION=8h

# Armazenamento de arquivos
STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=10

# Integrações externas simuladas
RECEITA_FEDERAL_API_MOCK=true
ESOCIAL_SANDBOX=true

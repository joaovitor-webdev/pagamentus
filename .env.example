# ==============================================================================
# Configurações do Ambiente (Exemplo - NÃO utilize dados reais)
# ==============================================================================
PORT=3000

# ------------------------------------------------------------------------------
# Controle de Ambiente (RF-079: Isolamento de Ambientes)
# Valores permitidos: 'development', 'test', 'production'
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# Banco de Dados Relacional (PostgreSQL - ADR-001)
# IMPORTANTE: Ambientes de teste e produção utilizam bancos estritamente separados!
#
# Para Ambiente de Desenvolvimento/Local:
# DATABASE_URL=postgresql://usuario_fake:senha_fake@localhost:5432/pagamentus_dev
#
# Para Execução de Testes Automatizados (RF-079):
# DATABASE_URL=postgresql://usuario_fake:senha_fake@localhost:5432/pagamentus_test
#
# Para Produção (configurado via secret manager do host / variáveis protegidas):
# DATABASE_URL=postgresql://usuario_prod:senha_forte@host_producao:5432/pagamentus_prod
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario_fake:senha_fake@localhost:5432/pagamentus_dev

# ------------------------------------------------------------------------------
# Segurança e Autenticação (JWT - ADR-001)
# Em produção, utilize chaves geradas criptograficamente e nunca as versione no Git.
# ------------------------------------------------------------------------------
JWT_SECRET=segredo_ficticio_para_desenvolvimento_apenas_12345
SESSION_SECRET=sessao_ficticia_exemplo
TOKEN_EXPIRATION=8h

# ------------------------------------------------------------------------------
# Armazenamento de Arquivos
# ------------------------------------------------------------------------------
STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# Integrações Externas (Mocks e Sandboxes para Testes - RF-079)
# Garante que em ambientes de desenvolvimento e teste nenhuma chamada real seja feita.
# ------------------------------------------------------------------------------
RECEITA_FEDERAL_API_MOCK=true
ESOCIAL_SANDBOX=true
